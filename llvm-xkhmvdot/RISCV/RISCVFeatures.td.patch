// Xkhmvdot Extensions

def FeatureVendorXkhmvdot
    : SubtargetFeature<"xkhmvdot", "HasVendorXkhmvdot", "true",
                       "'Xkhmvdot' (Kunminghu Vector Dot Product): vdot.vv, "
                       "4xINT8 dot product into INT32 accumulator">;
def HasVendorXkhmvdot : Predicate<"Subtarget->hasVendorXkhmvdot()">,
                        AssemblerPredicate<(all_of FeatureVendorXkhmvdot),
                            "'Xkhmvdot' (Kunminghu Vector Dot Product)">;
