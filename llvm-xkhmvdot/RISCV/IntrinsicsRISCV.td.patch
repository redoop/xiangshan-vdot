// ============================================================================
// Patch: llvm/include/llvm/IR/IntrinsicsRISCV.td — vdot IR intrinsic 声明
// 插入位置: Vector intrinsics 区（与 vwmaccu 同块）
// 模板: vmacc/vwmaccu 用 Intrinsic<[...], [...]> + [IntrNoMem]
//   vdot.vv: vint32m1_t = f(vd, vs1, vs2, vl)  [vl 传入, 无掩码变体 v1.0]
// ============================================================================

// Custom Xkhmvdot: vdot.vv (4xINT8 -> INT32 accumulate, VLEN=128 -> 4xi32)
let TargetPrefix = "riscv" in {
  class XkhmvdotNoMask
      : Intrinsic<[llvm_anyvector_ty],
                  [llvm_anyvector_ty, llvm_anyvector_ty, llvm_anyvector_ty,
                   llvm_anyint_ty],
                  [IntrNoMem, IntrSpeculatable]>;

  def int_riscv_vdot_vv : XkhmvdotNoMask;
}
